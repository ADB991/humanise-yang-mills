  YM.Spec.Final.phase : Materializes self.sector self.α ⋯
  YM.Spec.Final.B : Boundary.Contour S
  YM.Spec.Final.A : Boundary.Contour S
  YM.Spec.Final.action : Boundary.Wightman S
  YM.Spec.Final.realization : Relativistic self.sector self.α self.B self.A self.action ⋯
constructor:
  YM.Spec.Final.mk {G : Gauge} {C : Family G} {f : Extraction.Order} {S : Table C.book} (calibration : Calibrated C)
    (room : Seed C f S) (sector : Spec.Algebra S) (α : OS.Selection S) (phase : Materializes sector α ⋯)
    (B A : Boundary.Contour S) (action : Boundary.Wightman S) (realization : Relativistic sector α B A action ⋯) :
    Final C f S
@[reducible] def YM.Table.Stress : {G : Gauge} → {L : Register G} → Table L → Type :=
fun {G} {L} S => Axis → Axis → S.Field 4
structure YM.Table.Conserved {G : Gauge} {L : Register G} {S : Table L} (P : DiffPlan S) (H : S.RealSpin)
  (J : S.Stress) : Prop
number of parameters: 6
fields:
  YM.Table.Conserved.symmetric : ∀ (a b : Axis), J a b = J b a
  YM.Table.Conserved.real : ∀ (a b : Axis), (S.conj H 4) (J a b) = J a b
  YM.Table.Conserved.divergence : ∀ (b : Axis), ∑ a, (P.deriv 4 a) (J a b) = 0
constructor:
  YM.Table.Conserved.mk {G : Gauge} {L : Register G} {S : Table L} {P : DiffPlan S} {H : S.RealSpin} {J : S.Stress}
    (symmetric : ∀ (a b : Axis), J a b = J b a) (real : ∀ (a b : Axis), (S.conj H 4) (J a b) = J a b)
    (divergence : ∀ (b : Axis), ∑ a, (P.deriv 4 a) (J a b) = 0) : Table.Conserved P H J
def YM.Table.Tensorial : {G : Gauge} → {L : Register G} → {S : Table L} → S.Rotation → S.Stress → Prop :=
fun {G} {L} {S} R J => ∀ (K : Ortho) (a b : Axis), (R.act 4 K) (J a b) = ∑ i, ∑ j, ↑(↑K i a * ↑K j b) • J i j
structure YM.Table.StressLaws {G : Gauge} {L : Register G} {S : Table L} (T : Table L) (J : S.Stress)
  (Y : (d : ℕ) → Axis → S.Field d →ₗ[ℂ] S.Field (d + 1)) (A : (d : ℕ) → Ortho.Skew →ₗ[ℝ] S.Field d →ₗ[ℂ] S.Field d) :
  Prop
number of parameters: 7
fields:
  YM.Table.StressLaws.translation : ∀ {n : ℕ} {x : Points (n + 1)},
      x ∈ conf (n + 1) →
        ∀ (q : Fin n → S.Tag) {χ : E4 → ℝ},
          Table.Window x χ →
            ∀ (b : Axis) (d : ℕ) (B : S.Field d),
              Table.shellGrad T J χ b x q B = S.useAt T x (Fin.cons ⟨d + 1, (Y d b) B⟩ q)
  YM.Table.StressLaws.rotation : ∀ {n : ℕ} {x : Points (n + 1)},
      x ∈ conf (n + 1) →
        ∀ (q : Fin n → S.Tag) {χ : E4 → ℝ},
          Table.Window x χ →
            ∀ (g : Ortho.Skew) (d : ℕ) (B : S.Field d),
              Table.shellSpin T J χ g x q B = S.useAt T x (Fin.cons ⟨d, ((A d) g) B⟩ q)
constructor:
  YM.Table.StressLaws.mk {G : Gauge} {L : Register G} {S T : Table L} {J : S.Stress}
    {Y : (d : ℕ) → Axis → S.Field d →ₗ[ℂ] S.Field (d + 1)} {A : (d : ℕ) → Ortho.Skew →ₗ[ℝ] S.Field d →ₗ[ℂ] S.Field d}
    (translation :
      ∀ {n : ℕ} {x : Points (n + 1)},
        x ∈ conf (n + 1) →
          ∀ (q : Fin n → S.Tag) {χ : E4 → ℝ},
            Table.Window x χ →
              ∀ (b : Axis) (d : ℕ) (B : S.Field d),
                Table.shellGrad T J χ b x q B = S.useAt T x (Fin.cons ⟨d + 1, (Y d b) B⟩ q))
    (rotation :
      ∀ {n : ℕ} {x : Points (n + 1)},
        x ∈ conf (n + 1) →
          ∀ (q : Fin n → S.Tag) {χ : E4 → ℝ},
            Table.Window x χ →
              ∀ (g : Ortho.Skew) (d : ℕ) (B : S.Field d),
                Table.shellSpin T J χ g x q B = S.useAt T x (Fin.cons ⟨d, ((A d) g) B⟩ q)) :
    Table.StressLaws T J Y A
structure YM.Nonperturbative.Headline.TraceExclusions.{u, v} {G : Gauge} {C : Family G} {p : Extraction.Order}
  {S : Table C.book} (F : Final C p S) : Prop
number of parameters: 5
fields:
  YM.Nonperturbative.Headline.TraceExclusions.centered : ∀ (f : Boundary.Test4),
      inner ℂ F.action.operators.vacuum (TraceExtension.excitation F.action.operators (TraceExtension.pinned F) f) = 0
  YM.Nonperturbative.Headline.TraceExclusions.identified : ∀ (f : Boundary.Test4),
      (F.action.operators.field (TraceExtension.pinned F)) f =
        (F.action.operators.field ((S.pin 4) (TraceExtension.stressTrace F.sector.energy))) f -
          (TraceExtension.euclideanVEV S (TraceExtension.selected F) (TraceExtension.stressTrace F.sector.energy) *
              ∫ (x : E4), f x) •
            LinearMap.id
  YM.Nonperturbative.Headline.TraceExclusions.shortDistance : Filter.Tendsto
      (fun s => (s ^ 8 * Real.log s⁻¹ ^ 2) • TraceExtension.euclidean F s) (nhdsWithin 0 (Set.Ioi 0))
      (nhds ↑(Trace.Verse.award G))
  YM.Nonperturbative.Headline.TraceExclusions.positive : 0 < Trace.Verse.award G
  YM.Nonperturbative.Headline.TraceExclusions.wick : ∀ (Color : Type u) (palette : TraceExtension.Wick.Palette Color)
      (left right : TraceExtension.Wick.PolyField Color),
      ∃ x y,
        HasCompactSupport ⇑(TraceExtension.waveTest (TraceExtension.productTest x y)) ∧
          ((F.A.world.W 2) (TraceExtension.pairV F.action.J (TraceExtension.pinned F)))
              (TraceExtension.productTest x y) ≠
            palette.wicks left right ⇑(TraceExtension.waveTest (TraceExtension.productTest x y))
  YM.Nonperturbative.Headline.TraceExclusions.maxwell : ∀ (n : ℕ)
      (U : F.action.operators.H.space →ₗᵢ[ℂ] ↥(TraceExtension.Photons.Ambient n)),
      (∀ (w : F.action.operators.H.space), TraceExtension.Photons.PhysicalWave (U w)) →
        U F.action.operators.vacuum = TraceExtension.Photons.vacuum n →
          (∀ (w : F.action.operators.H.space) (b : E4),
              ∀ᵐ (x : TraceExtension.Photons.Wavespace n) ∂TraceExtension.Photons.sumMeasure n,
                ↑↑(U ((F.action.action.orbit.translation b) w)) x =
                  Boundary.Probe.plane (TraceExtension.Photons.forward x) b * ↑↑(U w) x) →
            ∃ f h,
              HasCompactSupport ⇑f ∧
                (∀ (i : TraceExtension.Photons.Label n), HasCompactSupport ⇑(h i)) ∧
                  (∀ (i : TraceExtension.Photons.Label n), Boundary.Probe.bar (h i) = h i) ∧
                    (∀ (i : TraceExtension.Photons.Label n), Boundary.Fields.causal f (h i)) ∧
                      inner ℂ (TraceExtension.Photons.coherent (-h)) (TraceExtension.Photons.signal F U f) ≠
                        inner ℂ (TraceExtension.Photons.signal F U (Boundary.Probe.bar f))
                          (TraceExtension.Photons.coherent h)
  YM.Nonperturbative.Headline.TraceExclusions.invariant : ∀ (n : ℕ)
      (U : F.action.operators.H.space →ₗᵢ[ℂ] ↥(TraceExtension.Photons.Ambient n)),
      TraceExtension.Photons.Comparison F U →
        ∀ (I : Type v) [inst : MeasurableSpace I] (μ : MeasureTheory.Measure I) [MeasureTheory.IsProbabilityMeasure μ]
          (P : I → ↥(TraceExtension.Photons.Ambient n) → ↥(TraceExtension.Photons.Ambient n)),
          (∀ (z : I) (x y : ↥(TraceExtension.Photons.Ambient n)),
              TraceExtension.Photons.PhysicalWave x →
                TraceExtension.Photons.PhysicalWave y → inner ℂ (P z x) (P z y) = inner ℂ x y) →
            (∀ (z : I) (x : F.action.operators.H.space), P z (U x) = U x) →
              ∀ (r : ℝ),
                0 < r →
                  ∃ A B,
                    IsOpen A ∧
                      IsOpen B ∧
                        closure A ⊆ Metric.ball 0 r ∧
                          (∀ x ∈ closure A, ∀ y ∈ closure B, x - y ∈ Mink.spacelike) ∧
                            ∃ f h,
                              tsupport ⇑f ⊆ A ∧
                                HasCompactSupport ⇑f ∧
                                  (∀ (i : TraceExtension.Photons.Label n), tsupport ⇑(h i) ⊆ B) ∧
                                    (∀ (i : TraceExtension.Photons.Label n), HasCompactSupport ⇑(h i)) ∧
                                      (∀ (i : TraceExtension.Photons.Label n), Boundary.Probe.bar (h i) = h i) ∧
                                        ∫ (z : I),
                                            inner ℂ (P z (TraceExtension.Photons.coherent (-h)))
                                              (TraceExtension.Photons.signal F U f) ∂μ ≠
                                          ∫ (z : I),
                                            inner ℂ (TraceExtension.Photons.signal F U (Boundary.Probe.bar f))
                                              (P z (TraceExtension.Photons.coherent h)) ∂μ
constructor:
  YM.Nonperturbative.Headline.TraceExclusions.mk.{u, v} {G : Gauge} {C : Family G} {p : Extraction.Order}
    {S : Table C.book} {F : Final C p S}
    (centered :
      ∀ (f : Boundary.Test4),
        inner ℂ F.action.operators.vacuum (TraceExtension.excitation F.action.operators (TraceExtension.pinned F) f) =
          0)
    (identified :
      ∀ (f : Boundary.Test4),
        (F.action.operators.field (TraceExtension.pinned F)) f =
          (F.action.operators.field ((S.pin 4) (TraceExtension.stressTrace F.sector.energy))) f -
            (TraceExtension.euclideanVEV S (TraceExtension.selected F) (TraceExtension.stressTrace F.sector.energy) *
                ∫ (x : E4), f x) •
              LinearMap.id)
    (shortDistance :
      Filter.Tendsto (fun s => (s ^ 8 * Real.log s⁻¹ ^ 2) • TraceExtension.euclidean F s) (nhdsWithin 0 (Set.Ioi 0))
        (nhds ↑(Trace.Verse.award G)))
    (positive : 0 < Trace.Verse.award G)
    (wick :
      ∀ (Color : Type u) (palette : TraceExtension.Wick.Palette Color)
        (left right : TraceExtension.Wick.PolyField Color),
        ∃ x y,
          HasCompactSupport ⇑(TraceExtension.waveTest (TraceExtension.productTest x y)) ∧
            ((F.A.world.W 2) (TraceExtension.pairV F.action.J (TraceExtension.pinned F)))
                (TraceExtension.productTest x y) ≠
              palette.wicks left right ⇑(TraceExtension.waveTest (TraceExtension.productTest x y)))
    (maxwell :
      ∀ (n : ℕ) (U : F.action.operators.H.space →ₗᵢ[ℂ] ↥(TraceExtension.Photons.Ambient n)),
        (∀ (w : F.action.operators.H.space), TraceExtension.Photons.PhysicalWave (U w)) →
          U F.action.operators.vacuum = TraceExtension.Photons.vacuum n →
            (∀ (w : F.action.operators.H.space) (b : E4),
                ∀ᵐ (x : TraceExtension.Photons.Wavespace n) ∂TraceExtension.Photons.sumMeasure n,
                  ↑↑(U ((F.action.action.orbit.translation b) w)) x =
                    Boundary.Probe.plane (TraceExtension.Photons.forward x) b * ↑↑(U w) x) →
              ∃ f h,
                HasCompactSupport ⇑f ∧
                  (∀ (i : TraceExtension.Photons.Label n), HasCompactSupport ⇑(h i)) ∧
                    (∀ (i : TraceExtension.Photons.Label n), Boundary.Probe.bar (h i) = h i) ∧
                      (∀ (i : TraceExtension.Photons.Label n), Boundary.Fields.causal f (h i)) ∧
                        inner ℂ (TraceExtension.Photons.coherent (-h)) (TraceExtension.Photons.signal F U f) ≠
                          inner ℂ (TraceExtension.Photons.signal F U (Boundary.Probe.bar f))
                            (TraceExtension.Photons.coherent h))
    (invariant :
      ∀ (n : ℕ) (U : F.action.operators.H.space →ₗᵢ[ℂ] ↥(TraceExtension.Photons.Ambient n)),
        TraceExtension.Photons.Comparison F U →
          ∀ (I : Type v) [inst : MeasurableSpace I] (μ : MeasureTheory.Measure I) [MeasureTheory.IsProbabilityMeasure μ]
            (P : I → ↥(TraceExtension.Photons.Ambient n) → ↥(TraceExtension.Photons.Ambient n)),
            (∀ (z : I) (x y : ↥(TraceExtension.Photons.Ambient n)),
                TraceExtension.Photons.PhysicalWave x →
                  TraceExtension.Photons.PhysicalWave y → inner ℂ (P z x) (P z y) = inner ℂ x y) →
              (∀ (z : I) (x : F.action.operators.H.space), P z (U x) = U x) →
                ∀ (r : ℝ),
                  0 < r →
                    ∃ A B,
                      IsOpen A ∧
                        IsOpen B ∧
                          closure A ⊆ Metric.ball 0 r ∧
                            (∀ x ∈ closure A, ∀ y ∈ closure B, x - y ∈ Mink.spacelike) ∧
                              ∃ f h,
                                tsupport ⇑f ⊆ A ∧
                                  HasCompactSupport ⇑f ∧
                                    (∀ (i : TraceExtension.Photons.Label n), tsupport ⇑(h i) ⊆ B) ∧
                                      (∀ (i : TraceExtension.Photons.Label n), HasCompactSupport ⇑(h i)) ∧
                                        (∀ (i : TraceExtension.Photons.Label n), Boundary.Probe.bar (h i) = h i) ∧
                                          ∫ (z : I),
                                              inner ℂ (P z (TraceExtension.Photons.coherent (-h)))
                                                (TraceExtension.Photons.signal F U f) ∂μ ≠
                                            ∫ (z : I),
                                              inner ℂ (TraceExtension.Photons.signal F U (Boundary.Probe.bar f))
                                                (P z (TraceExtension.Photons.coherent h)) ∂μ) :
    Headline.TraceExclusions F
@[reducible] def YM.TraceExtension.selected : {G : Gauge} →
  {C : Family G} → {f : Extraction.Order} → {S : Table C.book} → Final C f S → Table C.book :=
fun {G} {C} {f} {S} F => F.α.ensemble F.α.atPoint
def YM.TraceExtension.center : {G : Gauge} →
  {C : Family G} → {f : Extraction.Order} → {S : Table C.book} → Final C f S → S.Field 4 :=
fun {G} {C} {f} {S} F => TraceExtension.theta (TraceExtension.selected F) F.sector.energy
def YM.TraceExtension.pinned : {G : Gauge} →
  {C : Family G} → {f : Extraction.Order} → {S : Table C.book} → Final C f S → S.Union :=
fun {G} {C} {f} {S} F => (S.pin 4) (TraceExtension.center F)
def YM.TraceExtension.opposed : ℝ → Points 2 :=
fun r => Boundary.place 0 (TraceExtension.pairH (r / 2))
def YM.TraceExtension.euclidean : {G : Gauge} →
  {C : Family G} → {f : Extraction.Order} → {S : Table C.book} → Final C f S → ℝ → ℂ :=
fun {G} {C} {f} {S} F r =>
  S.useAt (TraceExtension.selected F) (TraceExtension.opposed r) fun x => ⟨4, TraceExtension.center F⟩
def YM.TraceExtension.stressTrace : {G : Gauge} → {L : Register G} → {S : Table L} → S.Stress → S.Field 4 :=
fun {G} {L} {S} J => ∑ i, J i i
def YM.TraceExtension.euclideanVEV : {G : Gauge} →
  {L : Register G} → (S : Table L) → Table L → {d : ℕ} → S.Field d → ℂ :=
fun {G} {L} S T {d} v => S.useAt T 0 fun x => ⟨d, v⟩
def YM.TraceExtension.centerIn : {G : Gauge} →
  {L : Register G} → (S : Table L) → Table L → {d : ℕ} → S.Field d → S.Field d :=
fun {G} {L} S T {d} v => v - TraceExtension.euclideanVEV S T v • S.unit d
def YM.TraceExtension.theta : {G : Gauge} → {L : Register G} → {S : Table L} → Table L → S.Stress → S.Field 4 :=
fun {G} {L} {S} T J => TraceExtension.centerIn S T (TraceExtension.stressTrace J)
def YM.Trace.Verse.award : Gauge → ℝ :=
fun G => 12 * (Trace.Over.d2 G ^ 2 / Trace.Over.b0 G ^ 2) * ↑G.lieDim / Real.pi ^ 4
@[reducible] def YM.Trace.Over.d2 : Gauge → ℝ :=
fun G => Trace.Over.forceR G
@[reducible] def YM.Trace.Over.forceR : Gauge → ℝ :=
fun G => -G.slopeConstant / 4
@[reducible] def YM.Trace.Over.b0 : Gauge → ℝ :=
fun G => 11 * G.casimir / (48 * Real.pi ^ 2)
def YM.Gauge.slopeConstant : Gauge → ℝ :=
fun G => 11 * G.casimir / (24 * Real.pi ^ 2)
@[reducible] def YM.Gauge.lieDim : Gauge → ℕ :=
fun G => Module.finrank ℝ G.Alg
@YangMills.publicTrace : ∀ {g : YangMills.GaugeGroup} {C : Family g.core} {p : Extraction.Order} {S : Table C.book}
  (F : Final C p S) (Q : Reader F.sector.derivatives F.sector.turns ⋯),
  g.IsSimple → Headline.TraceExclusions F → (YangMills.hierarchy F Q).TraceTest
'YangMills.publicTrace' depends on axioms: [propext, Classical.choice, Quot.sound]
structure YangMills.Hierarchy.TraceTest {g : YangMills.GaugeGroup} {C : YangMills.WilsonFamily g}
  (T : YangMills.Hierarchy C) : Prop
number of parameters: 3
fields:
  YangMills.Hierarchy.TraceTest.centered : ∀ (f : YangMills.TestFunction),
      inner ℂ ↑T.theory.fields.vacuum
          ↑(((T.theory.fields.field ((T.toLabel 4) T.centeredTrace)) f) T.theory.fields.vacuum) =
        0
  YangMills.Hierarchy.TraceTest.amplitudePositive : 0 < 3 * ↑(Module.finrank ℝ ↥g.lieAlgebra) / Real.pi ^ 4
  YangMills.Hierarchy.TraceTest.shortDistance : Filter.Tendsto (fun r => (r ^ 8 * Real.log r⁻¹ ^ 2) • T.traceTwo r)
      (nhdsWithin 0 (Set.Ioi 0)) (nhds ↑(3 * ↑(Module.finrank ℝ ↥g.lieAlgebra) / Real.pi ^ 4))
  YangMills.Hierarchy.TraceTest.excludes : ∀ (terms : List (ℂ × YangMills.Hierarchy.Track)),
      ¬T.traceTwo =ᶠ[nhdsWithin 0 (Set.Ioi 0)] YangMills.Hierarchy.wickProfile terms
constructor:
  YangMills.Hierarchy.TraceTest.mk {g : YangMills.GaugeGroup} {C : YangMills.WilsonFamily g} {T : YangMills.Hierarchy C}
    (centered :
      ∀ (f : YangMills.TestFunction),
        inner ℂ ↑T.theory.fields.vacuum
            ↑(((T.theory.fields.field ((T.toLabel 4) T.centeredTrace)) f) T.theory.fields.vacuum) =
          0)
    (amplitudePositive : 0 < 3 * ↑(Module.finrank ℝ ↥g.lieAlgebra) / Real.pi ^ 4)
    (shortDistance :
      Filter.Tendsto (fun r => (r ^ 8 * Real.log r⁻¹ ^ 2) • T.traceTwo r) (nhdsWithin 0 (Set.Ioi 0))
        (nhds ↑(3 * ↑(Module.finrank ℝ ↥g.lieAlgebra) / Real.pi ^ 4)))
    (excludes :
      ∀ (terms : List (ℂ × YangMills.Hierarchy.Track)),
        ¬T.traceTwo =ᶠ[nhdsWithin 0 (Set.Ioi 0)] YangMills.Hierarchy.wickProfile terms) :
    T.TraceTest
def YangMills.Hierarchy.timePair : ℝ → YangMills.Points 2 :=
fun r =>
  WithLp.toLp 2 fun i => WithLp.toLp 2 (Fin.snoc (fun x => 0) (Fin.append (fun x => -(r / 2)) (fun x => r / 2) i))
def YangMills.Hierarchy.traceTwo : {g : YangMills.GaugeGroup} →
  {C : YangMills.WilsonFamily g} → YangMills.Hierarchy C → ℝ → ℂ :=
fun {g} {C} T r => T.correlation (some T.selected) (fun x => ⟨4, T.centeredTrace⟩) (YangMills.Hierarchy.timePair r)
YangMills.constructed : ∀ (g : YangMills.GaugeGroup) (hg : g.IsSimple) (b : ℝ),
  0 < b →
    ∃ C,
      C.path.levels.clock.kernel.penalty = b ∧
        C.Makes ∧
          YangMills.WilsonRegularity (YangMills.wilsonFamily C) ∧
            ∀ (p : Extraction.Order),
              ∃ q S F L Q M X,
                (YangMills.hierarchy F Q).Properties (p.refine q).per.choose ∧
                  (YangMills.hierarchy F Q).Contacts ∧
                    { mesh := Extraction.Sequence.full, per := (p.refine q).per }.Ordered C S ∧
                      FullVolume.PositionsUV C Extraction.Sequence.full ∧
                        Calibrated C ∧
                          Independent.Core ⋯ F L Q ∧
                            Headline.Reconstruction F L ∧
                              (∀ (i : F.α.space.X), (YangMills.view (L.actors i)).Axioms) ∧
                                Headline.SeparatedOPE F Q ∧
                                  Headline.NestedOPE F Q ∧
                                    Headline.TraceExclusions F ∧
                                      M.basis = Q.port ∧
                                        Contacts.Solstice.MultipleLight F M ∧
                                          Nonempty (Contacts.Transport.SystemBasis M) ∧
                                            Nonempty (Contacts.Solstice.Thresholds M) ∧
                                              Pert.FirstExtension F X ∧ Pert.Position.FourMeters F X
'YangMills.constructed' depends on axioms: [propext, Classical.choice, Quot.sound]
