  {L : EveryPhase.Almanac F},
  EveryPhase.Completed F L →
    ∀ (i : F.α.space.X) (x : (L.actors i).operators.H.space),
      (∀ (p : E4), ((L.actors i).action.orbit.translation p) x = x) ↔ ∃ z, z • (L.actors i).operators.vacuum = x
