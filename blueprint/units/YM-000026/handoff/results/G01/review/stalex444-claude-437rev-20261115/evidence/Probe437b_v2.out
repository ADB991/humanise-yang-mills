structure YM.OS.Selection {G : Gauge} {L : Register G} (B : Table L) : Type 1
number of parameters: 3
fields:
  YM.OS.Selection.room : OS.Chamber B timeAxis
  YM.OS.Selection.unselected : OS.Spread self.room
  YM.OS.Selection.space : self.unselected.Resolution
  YM.OS.Selection.ensemble : self.space.X → Table L
  YM.OS.Selection.atPoint : self.space.X
  YM.OS.Selection.leaps : OS.Chamber (self.ensemble self.atPoint) timeAxis
  YM.OS.Selection.slabs : OS.Spread self.leaps
constructor:
  YM.OS.Selection.mk {G : Gauge} {L : Register G} {B : Table L} (room : OS.Chamber B timeAxis)
    (unselected : OS.Spread room) (space : unselected.Resolution) (ensemble : space.X → Table L) (atPoint : space.X)
    (leaps : OS.Chamber (ensemble atPoint) timeAxis) (slabs : OS.Spread leaps) : OS.Selection B
structure YM.OS.Spread.Resolution {G : Gauge} {L : Register G} {S : Table L} {V : OS.Chamber S timeAxis}
  (P : OS.Spread V) : Type 1
number of parameters: 5
fields:
  YM.OS.Spread.Resolution.X : Type
  YM.OS.Spread.Resolution.metric : MetricSpace self.X
  YM.OS.Spread.Resolution.sets : MeasurableSpace self.X
  YM.OS.Spread.Resolution.borel : BorelSpace self.X
  YM.OS.Spread.Resolution.compact : CompactSpace self.X
  YM.OS.Spread.Resolution.μ : MeasureTheory.Measure self.X
  YM.OS.Spread.Resolution.character : self.X → ↥P.algebra →⋆ₐ[ℂ] ℂ
constructor:
  YM.OS.Spread.Resolution.mk {G : Gauge} {L : Register G} {S : Table L} {V : OS.Chamber S timeAxis} {P : OS.Spread V}
    (X : Type) [metric : MetricSpace X] [sets : MeasurableSpace X] [borel : BorelSpace X] [compact : CompactSpace X]
    (μ : MeasureTheory.Measure X) (character : X → ↥P.algebra →⋆ₐ[ℂ] ℂ) : P.Resolution
structure YM.OS.Spread.Resolution.Out {G : Gauge} {L : Register G} {S : Table L} {V : OS.Chamber S timeAxis}
  {P : OS.Spread V} (R : P.Resolution) : Prop
number of parameters: 6
fields:
  YM.OS.Spread.Resolution.Out.abelian : ∀ (x y : ↥P.algebra), x * y = y * x
  YM.OS.Spread.Resolution.Out.normalized : MeasureTheory.IsProbabilityMeasure R.μ
  YM.OS.Spread.Resolution.Out.support : R.μ.IsOpenPosMeasure
  YM.OS.Spread.Resolution.Out.onto : Function.Bijective R.character
  YM.OS.Spread.Resolution.Out.values : ∀ (x : R.X), Continuous ⇑(R.character x)
  YM.OS.Spread.Resolution.Out.weak : ∀ (p : ↥P.algebra), Continuous fun x => (R.character x) p
  YM.OS.Spread.Resolution.Out.ground : ∀ (p : ↥P.algebra),
      ∫ (x : R.X), (R.character x) p ∂ R.μ = inner ℂ V.omega0 (↑p V.omega0)
constructor:
  YM.OS.Spread.Resolution.Out.mk {G : Gauge} {L : Register G} {S : Table L} {V : OS.Chamber S timeAxis}
    {P : OS.Spread V} {R : P.Resolution} (abelian : ∀ (x y : ↥P.algebra), x * y = y * x)
    (normalized : MeasureTheory.IsProbabilityMeasure R.μ) (support : R.μ.IsOpenPosMeasure)
    (onto : Function.Bijective R.character) (values : ∀ (x : R.X), Continuous ⇑(R.character x))
    (weak : ∀ (p : ↥P.algebra), Continuous fun x => (R.character x) p)
    (ground : ∀ (p : ↥P.algebra), ∫ (x : R.X), (R.character x) p ∂ R.μ = inner ℂ V.omega0 (↑p V.omega0)) : R.Out
def YM.OS.Spread.Resolution.receives : {G : Gauge} →
  {L : Register G} →
    {S : Table L} → {V : OS.Chamber S timeAxis} → {P : OS.Spread V} → (R : P.Resolution) → Table L → R.X → Prop :=
fun {G} {L} {S} {V} {P} R T i =>
  ∀ (w : L.Word),
    Word.distinct w →
      ∀ (s : E4) (d : NNReal) (h : OS.Slab timeAxis d (Word.carry w s)),
        T.expect w = (R.character i) (P.slot (Word.carry w s) d h)
def YM.OS.Spread.algebra : {G : Gauge} →
  {L : Register G} → {S : Table L} → {V : OS.Chamber S timeAxis} → OS.Spread V → StarSubalgebra ℂ V.VacuumOp :=
fun {G} {L} {S} {V} P => (StarAlgebra.adjoin ℂ P.generators).topologicalClosure
def YM.OS.Spread.atom : {G : Gauge} →
  {L : Register G} → {S : Table L} → {V : OS.Chamber S timeAxis} → OS.Spread V → L.Word → NNReal → V.VacuumOp :=
fun {G} {L} {S} {V} P w d => V.D.orthogonalProjectionOnto ∘SL P.place d w ∘SL V.D.subtypeL
@[reducible] def YM.OS.Chamber.D : {G : Gauge} →
  {L : Register G} → {S : Table L} → {a : Axis} → (C : OS.Chamber S a) → Submodule ℂ C.H.space :=
fun {G} {L} {S} {a} C => C.flow.ground
def YM.OS.Chamber.UniqueHeat : {G : Gauge} → {L : Register G} → {S : Table L} → {a : Axis} → OS.Chamber S a → Prop :=
fun {G} {L} {S} {a} C => ∀ (v : ↥C.D), ∃ z, z • C.omega0 = v
structure YM.OS.Selection.Certificate {G : Gauge} {L : Register G} {S : Table L} {P : DiffPlan S} (R : S.Rotation)
  (J : S.Stress) (C : OS.Selection S) : Prop
number of parameters: 7
fields:
  YM.OS.Selection.Certificate.lengths : C.unselected.Laws P
  YM.OS.Selection.Certificate.still : ∀ (x : ↥C.room.D) (i : OS.Cross timeAxis), (C.room.flow.U i) ↑x = ↑x
  YM.OS.Selection.Certificate.decomposition : C.space.Out
  YM.OS.Selection.Certificate.chosen : ∀ (i : C.space.X), C.space.receives (C.ensemble i) i
  YM.OS.Selection.Certificate.states : ∀ (i : C.space.X), (C.ensemble i).Hierarchy
  YM.OS.Selection.Certificate.sym : ∀ (i : C.space.X), R.Oriented (C.ensemble i)
  YM.OS.Selection.Certificate.retains : ∀ (i : C.space.X) (d : ℕ), (C.ensemble i).null d = S.null d
  YM.OS.Selection.Certificate.coordinates : ∀ (i : C.space.X), P.Inclusions (C.ensemble i)
  YM.OS.Selection.Certificate.calculus : ∀ (i : C.space.X), P.Derivatives (C.ensemble i)
  YM.OS.Selection.Certificate.flux : ∀ (i : C.space.X), Table.StressLaws (C.ensemble i) J P.deriv R.lie
  YM.OS.Selection.Certificate.goes : C.slabs.Laws P
  YM.OS.Selection.Certificate.heat : C.leaps.UniqueHeat
constructor:
  YM.OS.Selection.Certificate.mk {G : Gauge} {L : Register G} {S : Table L} {P : DiffPlan S} {R : S.Rotation}
    {J : S.Stress} {C : OS.Selection S} (lengths : C.unselected.Laws P)
    (still : ∀ (x : ↥C.room.D) (i : OS.Cross timeAxis), (C.room.flow.U i) ↑x = ↑x) (decomposition : C.space.Out)
    (chosen : ∀ (i : C.space.X), C.space.receives (C.ensemble i) i)
    (states : ∀ (i : C.space.X), (C.ensemble i).Hierarchy) (sym : ∀ (i : C.space.X), R.Oriented (C.ensemble i))
    (retains : ∀ (i : C.space.X) (d : ℕ), (C.ensemble i).null d = S.null d)
    (coordinates : ∀ (i : C.space.X), P.Inclusions (C.ensemble i))
    (calculus : ∀ (i : C.space.X), P.Derivatives (C.ensemble i))
    (flux : ∀ (i : C.space.X), Table.StressLaws (C.ensemble i) J P.deriv R.lie) (goes : C.slabs.Laws P)
    (heat : C.leaps.UniqueHeat) : OS.Selection.Certificate R J C
@OS.Spread.Resolution.barycenter : ∀ {G : Gauge} {L : Register G} {S : Table L} {V : OS.Chamber S timeAxis}
  {P : OS.Spread V} (R : P.Resolution) (T : R.X → Table L),
  R.Out →
    (∀ (i : R.X), R.receives (T i) i) →
      S.Homogeneous → ∀ (q : L.Word), Word.distinct q → ∫ (i : R.X), (T i).expect q ∂ R.μ = S.expect q
'YM.OS.Spread.Resolution.barycenter' depends on axioms: [propext, Classical.choice, Quot.sound]
structure YM.Table.Hierarchy {G : Gauge} {L : Register G} (S : Table L) : Prop
number of parameters: 3
fields:
  YM.Table.Hierarchy.laws : S.Basic
  YM.Table.Hierarchy.spin : S.RealSpin
  YM.Table.Hierarchy.translations : S.Homogeneous
  YM.Table.Hierarchy.positive : S.RP
  YM.Table.Hierarchy.onTests : S.RPSmear
  YM.Table.Hierarchy.smooth : S.Smooth
  YM.Table.Hierarchy.order : S.Capped
constructor:
  YM.Table.Hierarchy.mk {G : Gauge} {L : Register G} {S : Table L} (laws : S.Basic) (spin : S.RealSpin)
    (translations : S.Homogeneous) (positive : S.RP) (onTests : S.RPSmear) (smooth : S.Smooth) (order : S.Capped) :
    S.Hierarchy
structure YM.Nonperturbative.Headline.WightmanAxioms {G : Gauge} {C : Family G} {S : Table C.book}
  (A : Boundary.Wightman S) (W : Boundary.Surface S) : Prop
number of parameters: 5
fields:
  YM.Nonperturbative.Headline.WightmanAxioms.norm : ‖A.operators.vacuum‖ = 1
  YM.Nonperturbative.Headline.WightmanAxioms.dense : Dense ↑A.operators.domain
  YM.Nonperturbative.Headline.WightmanAxioms.cyclic : A.operators.domain =
      Submodule.span ℂ (Set.range A.operators.vector)
  YM.Nonperturbative.Headline.WightmanAxioms.tempered : ∀ (x : S.Union) (v : ↥A.operators.domain),
      Continuous fun f => ↑(((A.operators.field x) f) v)
  YM.Nonperturbative.Headline.WightmanAxioms.adjoints : ∀ (x : S.Union) (f : Boundary.Test4)
      (v w : ↥A.operators.domain),
      inner ℂ ↑(((A.operators.field x) f) v) ↑w = inner ℂ ↑v ↑(((A.operators.field (A.J x)) (Boundary.Probe.bar f)) w)
  YM.Nonperturbative.Headline.WightmanAxioms.moments : ∀ (b : Boundary.Sentence S),
      inner ℂ A.operators.vacuum (A.operators.vector b) = W.expect b
  YM.Nonperturbative.Headline.WightmanAxioms.positive : W.wordsPositive A.J
  YM.Nonperturbative.Headline.WightmanAxioms.localFields : ∀ (x y : S.Union) (f g : Boundary.Test4),
      Boundary.Fields.causal f g →
        ∀ (v : ↥A.operators.domain),
          ((A.operators.field x) f) (((A.operators.field y) g) v) =
            ((A.operators.field y) g) (((A.operators.field x) f) v)
  YM.Nonperturbative.Headline.WightmanAxioms.symmetries : Boundary.Symmetries A.spin A.action
  YM.Nonperturbative.Headline.WightmanAxioms.strong : ∀ (v : A.operators.H.space), Continuous fun g => (A.action.V g) v
  YM.Nonperturbative.Headline.WightmanAxioms.spectral : A.action.orbit.Spectrum A.momentum
  YM.Nonperturbative.Headline.WightmanAxioms.forward : A.momentum.region Mink.coneᶜ = 0
  YM.Nonperturbative.Headline.WightmanAxioms.unique : ∀ (v : A.operators.H.space),
      (∀ (x : E4), (A.action.orbit.translation x) v = v) → ∃ z, z • A.operators.vacuum = v
constructor:
  YM.Nonperturbative.Headline.WightmanAxioms.mk {G : Gauge} {C : Family G} {S : Table C.book} {A : Boundary.Wightman S}
    {W : Boundary.Surface S} (norm : ‖A.operators.vacuum‖ = 1) (dense : Dense ↑A.operators.domain)
    (cyclic : A.operators.domain = Submodule.span ℂ (Set.range A.operators.vector))
    (tempered : ∀ (x : S.Union) (v : ↥A.operators.domain), Continuous fun f => ↑(((A.operators.field x) f) v))
    (adjoints :
      ∀ (x : S.Union) (f : Boundary.Test4) (v w : ↥A.operators.domain),
        inner ℂ ↑(((A.operators.field x) f) v) ↑w =
          inner ℂ ↑v ↑(((A.operators.field (A.J x)) (Boundary.Probe.bar f)) w))
    (moments : ∀ (b : Boundary.Sentence S), inner ℂ A.operators.vacuum (A.operators.vector b) = W.expect b)
    (positive : W.wordsPositive A.J)
    (localFields :
      ∀ (x y : S.Union) (f g : Boundary.Test4),
        Boundary.Fields.causal f g →
          ∀ (v : ↥A.operators.domain),
            ((A.operators.field x) f) (((A.operators.field y) g) v) =
              ((A.operators.field y) g) (((A.operators.field x) f) v))
    (symmetries : Boundary.Symmetries A.spin A.action)
    (strong : ∀ (v : A.operators.H.space), Continuous fun g => (A.action.V g) v)
    (spectral : A.action.orbit.Spectrum A.momentum) (forward : A.momentum.region Mink.coneᶜ = 0)
    (unique :
      ∀ (v : A.operators.H.space),
        (∀ (x : E4), (A.action.orbit.translation x) v = v) → ∃ z, z • A.operators.vacuum = v) :
    Headline.WightmanAxioms A W
structure YM.Nonperturbative.Headline.Reconstruction {G : Gauge} {C : Family G} {p : Extraction.Order}
  {S : Table C.book} (F : Final C p S) (L : EveryPhase.Almanac F) : Prop
number of parameters: 6
fields:
  YM.Nonperturbative.Headline.Reconstruction.unselected : F.B.From S
  YM.Nonperturbative.Headline.Reconstruction.selected : F.A.From (F.α.ensemble F.α.atPoint)
  YM.Nonperturbative.Headline.Reconstruction.chosen : Headline.WightmanAxioms F.action F.A.world
  YM.Nonperturbative.Headline.Reconstruction.characters : ∀ (i : F.α.space.X),
      Headline.WightmanAxioms (L.actors i) (L.contours i).world
  YM.Nonperturbative.Headline.Reconstruction.average : ∀ (n : ℕ) (v : Fin n → S.Union) (g : Boundary.Joint n),
      ∫ (i : F.α.space.X), (((L.contours i).world.W n) v) g ∂F.α.space.μ = ((F.B.world.W n) v) g
constructor:
  YM.Nonperturbative.Headline.Reconstruction.mk {G : Gauge} {C : Family G} {p : Extraction.Order} {S : Table C.book}
    {F : Final C p S} {L : EveryPhase.Almanac F} (unselected : F.B.From S)
    (selected : F.A.From (F.α.ensemble F.α.atPoint)) (chosen : Headline.WightmanAxioms F.action F.A.world)
    (characters : ∀ (i : F.α.space.X), Headline.WightmanAxioms (L.actors i) (L.contours i).world)
    (average :
      ∀ (n : ℕ) (v : Fin n → S.Union) (g : Boundary.Joint n),
        ∫ (i : F.α.space.X), (((L.contours i).world.W n) v) g ∂F.α.space.μ = ((F.B.world.W n) v) g) :
    Headline.Reconstruction F L
structure YM.EveryPhase.Almanac {G : Gauge} {C : Family G} {S : Table C.book} {f : Extraction.Order} (F : Final C f S) :
  Type 1
number of parameters: 5
fields:
  YM.EveryPhase.Almanac.chambers : (i : F.α.space.X) → OS.Chamber (F.α.ensemble i) timeAxis
  YM.EveryPhase.Almanac.spreads : (i : F.α.space.X) → OS.Spread (self.chambers i)
  YM.EveryPhase.Almanac.pantries : ∀ (i : F.α.space.X),
      Bid.Pantry S (F.α.ensemble i) (self.chambers i) F.sector.derivatives (self.spreads i)
  YM.EveryPhase.Almanac.contours : F.α.space.X → Boundary.Contour S
  YM.EveryPhase.Almanac.cards : ∀ (i : F.α.space.X),
      Next.BOUNDARY.Compatible S (self.spreads i) F.sector F.action.spin ⋯ (self.contours i)
  YM.EveryPhase.Almanac.actors : F.α.space.X → Boundary.Wightman S
  YM.EveryPhase.Almanac.letters : ∀ (i : F.α.space.X), (self.actors i).J = F.action.J
  YM.EveryPhase.Almanac.spins : ∀ (i : F.α.space.X), (self.actors i).spin = F.action.spin
  YM.EveryPhase.Almanac.cores : ∀ (i : F.α.space.X),
      Next.BOUNDARY.FieldCore (self.contours i).world F.sector.turns ⋯ (self.actors i)
  YM.EveryPhase.Almanac.J : (i : F.α.space.X) → (self.actors i).operators.H.space →L[ℂ] (self.chambers i).H.space
  YM.EveryPhase.Almanac.links : ∀ (i : F.α.space.X),
      Next.BOUNDARY.Attachment (self.actors i) (self.chambers i) (self.J i)
  YM.EveryPhase.Almanac.baseC : self.chambers F.α.atPoint = F.α.leaps
  YM.EveryPhase.Almanac.baseS : self.spreads F.α.atPoint ≍ F.α.slabs
  YM.EveryPhase.Almanac.baseB : self.contours F.α.atPoint = F.A
  YM.EveryPhase.Almanac.baseR : self.actors F.α.atPoint = F.action
constructor:
  YM.EveryPhase.Almanac.mk {G : Gauge} {C : Family G} {S : Table C.book} {f : Extraction.Order} {F : Final C f S}
    (chambers : (i : F.α.space.X) → OS.Chamber (F.α.ensemble i) timeAxis)
    (spreads : (i : F.α.space.X) → OS.Spread (chambers i))
    (pantries : ∀ (i : F.α.space.X), Bid.Pantry S (F.α.ensemble i) (chambers i) F.sector.derivatives (spreads i))
    (contours : F.α.space.X → Boundary.Contour S)
    (cards : ∀ (i : F.α.space.X), Next.BOUNDARY.Compatible S (spreads i) F.sector F.action.spin ⋯ (contours i))
    (actors : F.α.space.X → Boundary.Wightman S) (letters : ∀ (i : F.α.space.X), (actors i).J = F.action.J)
    (spins : ∀ (i : F.α.space.X), (actors i).spin = F.action.spin)
    (cores : ∀ (i : F.α.space.X), Next.BOUNDARY.FieldCore (contours i).world F.sector.turns ⋯ (actors i))
    (J : (i : F.α.space.X) → (actors i).operators.H.space →L[ℂ] (chambers i).H.space)
    (links : ∀ (i : F.α.space.X), Next.BOUNDARY.Attachment (actors i) (chambers i) (J i))
    (baseC : chambers F.α.atPoint = F.α.leaps) (baseS : spreads F.α.atPoint ≍ F.α.slabs)
    (baseB : contours F.α.atPoint = F.A) (baseR : actors F.α.atPoint = F.action) : EveryPhase.Almanac F
structure YM.EveryPhase.Completed {G : Gauge} {C : Family G} {S : Table C.book} {f : Extraction.Order} (F : Final C f S)
  (L : EveryPhase.Almanac F) : Prop
number of parameters: 6
fields:
  YM.EveryPhase.Completed.isTheory : ∀ (i : F.α.space.X), (L.actors i).Realizes F.sector.turns ⋯
  YM.EveryPhase.Completed.into_onto : ∀ (i : F.α.space.X), Function.Surjective ⇑(L.J i)
  YM.EveryPhase.Completed.euclid : ∀ (i : F.α.space.X), (L.chambers i).UniqueHeat
  YM.EveryPhase.Completed.mink : ∀ (i : F.α.space.X) (x : (L.actors i).operators.H.space),
      ((L.actors i).momentum.region EveryPhase.zeroE) x = x ↔ ∃ z, z • (L.actors i).operators.vacuum = x
  YM.EveryPhase.Completed.light : ∀ (A : EveryPhase.SumOfWords S),
      EveryPhase.finite A →
        ∃ M,
          0 ≤ M ∧
            ∀ (i : F.α.space.X), ∀ u ∈ Set.Ioc 0 1, (EveryPhase.νletter L i A).real (EveryPhase.lowE u) ≤ M * u ^ 2
  YM.EveryPhase.Completed.heat : ∀ (A : EveryPhase.SumOfWords S),
      EveryPhase.finite A →
        ∃ M,
          0 ≤ M ∧
            ∀ (i : F.α.space.X),
              ∀ s ≥ 1,
                let x := EveryPhase.stands (L.actors i).operators A;
                let P := (L.actors i).momentum.region EveryPhase.zeroE;
                let r := inner ℂ x ((EveryPhase.bHeat (L.J i) s - P) x);
                0 ≤ r ∧ r ≤ ↑(M * (↑s)⁻¹ ^ 2)
  YM.EveryPhase.Completed.commutant : ∀ (i : F.α.space.X) (B : (L.actors i).operators.H.Op),
      EveryPhase.member (L.actors i) B ↔ ∃ a, B = a • ContinuousLinearMap.id ℂ (L.actors i).operators.H.space
  YM.EveryPhase.Completed.continued_stress : ∀ (i : F.α.space.X),
      EveryPhase.Stress.Force S (F.α.ensemble i) (L.contours i) F.sector.turns F.sector.derivatives ⋯ (L.actors i)
        F.sector.energy
  YM.EveryPhase.Completed.depends : ∀ (n : ℕ) (v : Fin n → S.Union) (g : Boundary.Joint n),
      Continuous fun i => (((L.contours i).world.W n) v) g
  YM.EveryPhase.Completed.at_words : ∀ (v : C.book.Word),
      Word.distinct v → ∫ (i : F.α.space.X), (F.α.ensemble i).expect v ∂F.α.space.μ = S.expect v
  YM.EveryPhase.Completed.at_boundary : ∀ (n : ℕ) (v : Fin n → S.Union) (g : Boundary.Joint n),
      ∫ (i : F.α.space.X), (((L.contours i).world.W n) v) g ∂F.α.space.μ = ((F.B.world.W n) v) g
constructor:
  YM.EveryPhase.Completed.mk {G : Gauge} {C : Family G} {S : Table C.book} {f : Extraction.Order} {F : Final C f S}
    {L : EveryPhase.Almanac F} (isTheory : ∀ (i : F.α.space.X), (L.actors i).Realizes F.sector.turns ⋯)
    (into_onto : ∀ (i : F.α.space.X), Function.Surjective ⇑(L.J i))
    (euclid : ∀ (i : F.α.space.X), (L.chambers i).UniqueHeat)
    (mink :
      ∀ (i : F.α.space.X) (x : (L.actors i).operators.H.space),
        ((L.actors i).momentum.region EveryPhase.zeroE) x = x ↔ ∃ z, z • (L.actors i).operators.vacuum = x)
    (light :
      ∀ (A : EveryPhase.SumOfWords S),
        EveryPhase.finite A →
          ∃ M,
            0 ≤ M ∧
              ∀ (i : F.α.space.X), ∀ u ∈ Set.Ioc 0 1, (EveryPhase.νletter L i A).real (EveryPhase.lowE u) ≤ M * u ^ 2)
    (heat :
      ∀ (A : EveryPhase.SumOfWords S),
        EveryPhase.finite A →
          ∃ M,
            0 ≤ M ∧
              ∀ (i : F.α.space.X),
                ∀ s ≥ 1,
                  let x := EveryPhase.stands (L.actors i).operators A;
                  let P := (L.actors i).momentum.region EveryPhase.zeroE;
                  let r := inner ℂ x ((EveryPhase.bHeat (L.J i) s - P) x);
                  0 ≤ r ∧ r ≤ ↑(M * (↑s)⁻¹ ^ 2))
    (commutant :
      ∀ (i : F.α.space.X) (B : (L.actors i).operators.H.Op),
        EveryPhase.member (L.actors i) B ↔ ∃ a, B = a • ContinuousLinearMap.id ℂ (L.actors i).operators.H.space)
    (continued_stress :
      ∀ (i : F.α.space.X),
        EveryPhase.Stress.Force S (F.α.ensemble i) (L.contours i) F.sector.turns F.sector.derivatives ⋯ (L.actors i)
          F.sector.energy)
    (depends :
      ∀ (n : ℕ) (v : Fin n → S.Union) (g : Boundary.Joint n), Continuous fun i => (((L.contours i).world.W n) v) g)
    (at_words :
      ∀ (v : C.book.Word), Word.distinct v → ∫ (i : F.α.space.X), (F.α.ensemble i).expect v ∂F.α.space.μ = S.expect v)
    (at_boundary :
      ∀ (n : ℕ) (v : Fin n → S.Union) (g : Boundary.Joint n),
        ∫ (i : F.α.space.X), (((L.contours i).world.W n) v) g ∂F.α.space.μ = ((F.B.world.W n) v) g) :
    EveryPhase.Completed F L
@EveryPhase.recognizes : ∀ {G : Gauge} {C : Family G} {S : Table C.book} {f : Extraction.Order} (F : Final C f S)
  {L : EveryPhase.Almanac F},
  EveryPhase.Completed F L →
    ∀ (i : F.α.space.X) (d : ℕ) (v : C.book.Ref d),
      (F.α.ensemble i).vanishes d v ↔
        ∀ (f_1 : Boundary.Test4), ((L.actors i).operators.field ((S.pin d) ((S.project d) v))) f_1 = 0
