structure YM.Independent.Core.{u, v} {G : Gauge} {C : Family G} {f : Extraction.Order} {S : Table C.book}
  (hG : G.Simple) (F : Final C f S) (L : EveryPhase.Almanac F) (Q : Reader F.sector.derivatives F.sector.turns ⋯) : Prop
number of parameters: 8
fields:
  YM.Independent.Core.services : OPE.Services C f S
  YM.Independent.Core.reconstruction : EveryPhase.Completed F L
  YM.Independent.Core.trace : Integration.ManuscriptTraceTests.Tests F hG
  YM.Independent.Core.ope : Foundation F Q
  YM.Independent.Core.joint : ∀ (I J : Type) [inst : Fintype I] [inst_1 : Fintype J] (d : I → ℕ) (e : J → ℕ)
      (a : Labels S d) (b : Labels S e) (M η c ε : ℝ),
      0 ≤ M →
        0 < η →
          0 < c →
            0 < ε →
              ∀ (D : ℕ) (K : Type) [inst_2 : MeasurableSpace K] (B : ℝ),
                ∀ᶠ (r : ℝ) in nhdsWithin 0 (Set.Ioi 0),
                  ∀ (μ : MeasureTheory.Measure K) (w : K → ℂ) (p : K → Loc I J),
                    AEMeasurable p μ →
                      MeasureTheory.Integrable w μ →
                        ∫ (s : K), ‖w s‖ ∂μ ≤ B →
                          (∀ᵐ (s : K) ∂μ, w s ≠ 0 → p s ∈ FitsOn I J M η c r) →
                            (∀ (χ : K → F.α.space.X),
                                AEMeasurable χ μ →
                                  JointEstimate F Q D a b (B * costRemainder D d ε r) μ w p (some ∘ χ)) ∧
                              JointEstimate F Q D a b (B * costRemainder D d ε r) μ w p fun x => none
constructor:
  YM.Independent.Core.mk.{u, v} {G : Gauge} {C : Family G} {f : Extraction.Order} {S : Table C.book} {hG : G.Simple}
    {F : Final C f S} {L : EveryPhase.Almanac F} {Q : Reader F.sector.derivatives F.sector.turns ⋯}
    (services : OPE.Services C f S) (reconstruction : EveryPhase.Completed F L)
    (trace : Integration.ManuscriptTraceTests.Tests F hG) (ope : Foundation F Q)
    (joint :
      ∀ (I J : Type) [inst : Fintype I] [inst_1 : Fintype J] (d : I → ℕ) (e : J → ℕ) (a : Labels S d) (b : Labels S e)
        (M η c ε : ℝ),
        0 ≤ M →
          0 < η →
            0 < c →
              0 < ε →
                ∀ (D : ℕ) (K : Type) [inst_2 : MeasurableSpace K] (B : ℝ),
                  ∀ᶠ (r : ℝ) in nhdsWithin 0 (Set.Ioi 0),
                    ∀ (μ : MeasureTheory.Measure K) (w : K → ℂ) (p : K → Loc I J),
                      AEMeasurable p μ →
                        MeasureTheory.Integrable w μ →
                          ∫ (s : K), ‖w s‖ ∂μ ≤ B →
                            (∀ᵐ (s : K) ∂μ, w s ≠ 0 → p s ∈ FitsOn I J M η c r) →
                              (∀ (χ : K → F.α.space.X),
                                  AEMeasurable χ μ →
                                    JointEstimate F Q D a b (B * costRemainder D d ε r) μ w p (some ∘ χ)) ∧
                                JointEstimate F Q D a b (B * costRemainder D d ε r) μ w p fun x => none) :
    Independent.Core hG F L Q
def YM.Mink.cone : Set E4 :=
{x | ‖spatial x‖ ≤ time x}
@[reducible] def YM.timeAxis : Axis :=
Fin.last 3
structure YM.Nonperturbative.Headline.SeparatedOPE {G : Gauge} {C : Family G} {p : Extraction.Order} {S : Table C.book}
  (F : Final C p S) (Q : Reader F.sector.derivatives F.sector.turns ⋯) : Prop
number of parameters: 6
fields:
  YM.Nonperturbative.Headline.SeparatedOPE.coefficient : ∀ (I : Type) [inst : Fintype I] (d : I → ℕ) (a : Labels S d)
      (M η ε : ℝ),
      0 ≤ M →
        0 < η →
          0 < ε →
            ∀ (j : ℕ) (i : Q.channels j),
              ∀ᶠ (r : ℝ) in nhdsWithin 0 (Set.Ioi 0),
                ∀ (x : I → E4) (o : E4), OPE.WithinRoom r M η x o → ‖Q.coef j i x a o‖ ≤ r ^ (↑j - weight d - ε)
  YM.Nonperturbative.Headline.SeparatedOPE.remainder : ∀ {I J : Type} [inst : Fintype I] [inst_1 : Fintype J]
      {d : I → ℕ} {e : J → ℕ} (a : Labels S d) (b : Labels S e) {M η c ε : ℝ},
      0 ≤ M →
        0 < η →
          0 < c →
            0 < ε →
              ∀ (D : ℕ),
                ∀ᶠ (r : ℝ) in nhdsWithin 0 (Set.Ioi 0),
                  ∀ (x : I → E4) (o : E4) (y : J → E4),
                    OPE.WithinRoom r M η x o →
                      OPE.ClearOf o y c →
                        ∀ (s : OPE.Viewers F),
                          ‖whole (OPE.spectator F s) x a y b -
                                ∑ j,
                                  ∑ i,
                                    Q.coef (↑j) i x a o *
                                      whole (OPE.spectator F s) (OPE.sole o) (OPE.sole (Q.actor (↑j) i)) y b‖ ≤
                            r ^ (↑D + 1 - weight d - ε)
  YM.Nonperturbative.Headline.SeparatedOPE.profiles : ∀ (I J : Type) [inst : Fintype I] [inst_1 : Fintype J] (d : I → ℕ)
      (e : J → ℕ) (a : Labels S d) (b : Labels S e) (M η c ε : ℝ),
      0 ≤ M →
        0 < η →
          0 < c →
            0 < ε →
              ∀ (D : ℕ) (K : Type) [inst_2 : MeasurableSpace K] (B : ℝ),
                ∀ᶠ (r : ℝ) in nhdsWithin 0 (Set.Ioi 0),
                  ∀ (μ : MeasureTheory.Measure K) (w : K → ℂ) (z : K → Loc I J),
                    AEMeasurable z μ →
                      MeasureTheory.Integrable w μ →
                        ∫ (i : K), ‖w i‖ ∂μ ≤ B →
                          (∀ᵐ (i : K) ∂μ, w i ≠ 0 → z i ∈ FitsOn I J M η c r) →
                            (∀ (χ : K → F.α.space.X),
                                AEMeasurable χ μ →
                                  JointEstimate F Q D a b (B * r ^ (↑D + 1 - weight d - ε)) μ w z (some ∘ χ)) ∧
                              JointEstimate F Q D a b (B * r ^ (↑D + 1 - weight d - ε)) μ w z fun x => none
constructor:
  YM.Nonperturbative.Headline.SeparatedOPE.mk {G : Gauge} {C : Family G} {p : Extraction.Order} {S : Table C.book}
    {F : Final C p S} {Q : Reader F.sector.derivatives F.sector.turns ⋯}
    (coefficient :
      ∀ (I : Type) [inst : Fintype I] (d : I → ℕ) (a : Labels S d) (M η ε : ℝ),
        0 ≤ M →
          0 < η →
            0 < ε →
              ∀ (j : ℕ) (i : Q.channels j),
                ∀ᶠ (r : ℝ) in nhdsWithin 0 (Set.Ioi 0),
                  ∀ (x : I → E4) (o : E4), OPE.WithinRoom r M η x o → ‖Q.coef j i x a o‖ ≤ r ^ (↑j - weight d - ε))
    (remainder :
      ∀ {I J : Type} [inst : Fintype I] [inst_1 : Fintype J] {d : I → ℕ} {e : J → ℕ} (a : Labels S d) (b : Labels S e)
        {M η c ε : ℝ},
        0 ≤ M →
          0 < η →
            0 < c →
              0 < ε →
                ∀ (D : ℕ),
                  ∀ᶠ (r : ℝ) in nhdsWithin 0 (Set.Ioi 0),
                    ∀ (x : I → E4) (o : E4) (y : J → E4),
                      OPE.WithinRoom r M η x o →
                        OPE.ClearOf o y c →
                          ∀ (s : OPE.Viewers F),
                            ‖whole (OPE.spectator F s) x a y b -
                                  ∑ j,
                                    ∑ i,
                                      Q.coef (↑j) i x a o *
                                        whole (OPE.spectator F s) (OPE.sole o) (OPE.sole (Q.actor (↑j) i)) y b‖ ≤
                              r ^ (↑D + 1 - weight d - ε))
    (profiles :
      ∀ (I J : Type) [inst : Fintype I] [inst_1 : Fintype J] (d : I → ℕ) (e : J → ℕ) (a : Labels S d) (b : Labels S e)
        (M η c ε : ℝ),
        0 ≤ M →
          0 < η →
            0 < c →
              0 < ε →
                ∀ (D : ℕ) (K : Type) [inst_2 : MeasurableSpace K] (B : ℝ),
                  ∀ᶠ (r : ℝ) in nhdsWithin 0 (Set.Ioi 0),
                    ∀ (μ : MeasureTheory.Measure K) (w : K → ℂ) (z : K → Loc I J),
                      AEMeasurable z μ →
                        MeasureTheory.Integrable w μ →
                          ∫ (i : K), ‖w i‖ ∂μ ≤ B →
                            (∀ᵐ (i : K) ∂μ, w i ≠ 0 → z i ∈ FitsOn I J M η c r) →
                              (∀ (χ : K → F.α.space.X),
                                  AEMeasurable χ μ →
                                    JointEstimate F Q D a b (B * r ^ (↑D + 1 - weight d - ε)) μ w z (some ∘ χ)) ∧
                                JointEstimate F Q D a b (B * r ^ (↑D + 1 - weight d - ε)) μ w z fun x => none) :
    Headline.SeparatedOPE F Q
@[reducible] def YM.OPE.Viewers : {G : Gauge} →
  {C : Family G} → {S : Table C.book} → {F : Extraction.Order} → Final C F S → Type :=
fun {G} {C} {S} {F} U => Option U.α.space.X
def YM.OPE.spectator : {G : Gauge} →
  {C : Family G} → {S : Table C.book} → {F : Extraction.Order} → (U : Final C F S) → OPE.Viewers U → Table C.book :=
fun {G} {C} {S} {F} U v => Option.elim v S U.α.ensemble
