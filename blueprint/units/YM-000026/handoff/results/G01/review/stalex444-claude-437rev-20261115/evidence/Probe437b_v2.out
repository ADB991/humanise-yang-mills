  YM.Spec.Materializes.mk {G : Gauge} {C : Family G} {Z : Table C.book} {X : Spec.Algebra Z} {Y : OS.Selection Z}
    {h : Z.RealSpin} (transport : Locals X h) (phase : OS.Selection.Certificate X.turns X.energy Y) : Materializes X Y h
def YM.Spec.Calibrated : {G : Gauge} → Family G → Prop :=
fun {G} C =>
  ∃ S D T W Y I O K P B F,
    B.bake.Stays F ∧ C.path = B.bake.make F ∧ ∀ (N m p : ℕ), m < N → B.Move N m p (F N p m) (F N p (m + 1))
