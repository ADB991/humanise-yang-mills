  YM.Next.Rank.Tapes.CorridorSky.races : YM.Next.Rank.Tapes.Racer p (YM.Next.Rank.Atlas.clim A k)
      (k - YM.Next.Rank.Station.middleSky A s k)
  YM.Next.Rank.Tapes.CorridorSky.spend : YM.Next.Rank.Tapes.Faring p (YM.Next.Rank.Atlas.clim A k)
  YM.Next.Rank.Tapes.CorridorSky.court : ∀ (i : ℕ),
      YM.Next.Rank.Station.widthSky A s k ≤ i →
        i ≤ k → YM.Next.Rank.Atlas.clim A i ∈ Set.Icc (YM.Next.Rank.Atlas.clim A k / 2) (YM.Next.Rank.Atlas.clim A k)
constructor:
  YM.Next.Rank.Tapes.CorridorSky.mk {G : YM.Gauge} {A : YM.RG.Levels G} {s : ℝ} {p : YM.Next.Rank.Tapes.Purse} {k : ℕ}
    (heft : YM.Next.Rank.Station.AllowedSky A s k)
    (races : YM.Next.Rank.Tapes.Racer p (YM.Next.Rank.Atlas.clim A k) (k - YM.Next.Rank.Station.middleSky A s k))
    (spend : YM.Next.Rank.Tapes.Faring p (YM.Next.Rank.Atlas.clim A k))
    (court :
      ∀ (i : ℕ),
        YM.Next.Rank.Station.widthSky A s k ≤ i →
          i ≤ k →
            YM.Next.Rank.Atlas.clim A i ∈ Set.Icc (YM.Next.Rank.Atlas.clim A k / 2) (YM.Next.Rank.Atlas.clim A k)) :
    YM.Next.Rank.Tapes.CorridorSky A s p k
structure YM.PhysicalNext.InteractingRank.Soft.ShelterSky {G : YM.Gauge} (T : YM.RG.Levels G) (m : ℕ) (b : ℝ) : Prop
number of parameters: 4
fields:
  YM.PhysicalNext.InteractingRank.Soft.ShelterSky.covers : YM.Next.Rank.Station.AllowedSky T b m
  YM.PhysicalNext.InteractingRank.Soft.ShelterSky.warm : ∀ (i : ℕ),
      YM.Next.Rank.Station.widthSky T b m ≤ i →
        i ≤ m →
          3 / 4 * YM.Next.Rank.Atlas.clim T m ≤ YM.Next.Rank.Atlas.clim T i ∧
            YM.Next.Rank.Atlas.clim T i ≤ YM.Next.Rank.Atlas.clim T m
constructor:
  YM.PhysicalNext.InteractingRank.Soft.ShelterSky.mk {G : YM.Gauge} {T : YM.RG.Levels G} {m : ℕ} {b : ℝ}
    (covers : YM.Next.Rank.Station.AllowedSky T b m)
    (warm :
      ∀ (i : ℕ),
        YM.Next.Rank.Station.widthSky T b m ≤ i →
          i ≤ m →
            3 / 4 * YM.Next.Rank.Atlas.clim T m ≤ YM.Next.Rank.Atlas.clim T i ∧
              YM.Next.Rank.Atlas.clim T i ≤ YM.Next.Rank.Atlas.clim T m) :
    YM.PhysicalNext.InteractingRank.Soft.ShelterSky T m b
@slackSky : ∀ {G : YM.Gauge} {X : YM.RG.Supply.Sheet G} {D : YM.RG.Supply.Rolls X} {R : YM.RG.Supply.Protection D}
  {E : YM.RG.Supply.Delays R} {Z : YM.RG.Supply.Bar E} (W : YM.RG.Supply.Wait Z) {A : YM.RG.Levels G},
  YM.RG.Supply.Paid W A →
    ∀ {i j k m : ℕ} {b u : ℝ},
      A.clock.J k = m + 1 →
        m = A.clock.J i →
          i ≤ k →
            0 ≤ b →
              j = YM.PhysicalNext.InteractingRank.Soft.stretch (↑↑(D.L m)) b (YM.Next.Rank.Atlas.clim A k) →
                j ≤ k - i →
                  u ≤ b →
                    YM.PhysicalNext.InteractingRank.Soft.runTicket Z b (m + 1) (A.S.scale k) →
                      G.Simple → YM.PhysicalNext.InteractingRank.Soft.ShelterSky A k u
'_private.YM.TraceExtension.Prom.Order.Graph.0.YM.PhysicalNext.InteractingRank.Soft.slackSky' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
@YM.PhysicalNext.InteractingRank.Soft.atlasSky : ∀ {G : YM.Gauge} {X : YM.RG.Supply.Sheet G} {D : YM.RG.Supply.Rolls X}
  {R : YM.RG.Supply.Protection D} {E : YM.RG.Supply.Delays R} {Z : YM.RG.Supply.Bar E} (W : YM.RG.Supply.Wait Z)
  {A : YM.RG.Levels G},
  YM.RG.Supply.Paid W A →
    ∀ {k m : ℕ} {b u : ℝ},
      A.clock.J k = m + 1 →
        X.first ≤ m →
          (∀ (s : ℝ),
              W.readyHere m ≤ s →
                YM.PhysicalNext.InteractingRank.Soft.runTicket Z b (m + 1) s ∧
                  YM.Next.Rank.Ship.benchCost Z b m (3 * s) ≤ W.window m s) →
            u ≤ b →
              0 ≤ b → G.Simple → W.readyHere m ≤ A.S.scale k ∧ YM.PhysicalNext.InteractingRank.Soft.ShelterSky A k u
'YM.PhysicalNext.InteractingRank.Soft.atlasSky' depends on axioms: [propext, Classical.choice, Quot.sound]
@YM.PhysicalNext.InteractingRank.Soft.forwardSky : ∀ {ι : Type} [Fintype ι] {G : YM.Gauge} {X : YM.RG.Supply.Sheet G}
  {D : YM.RG.Supply.Rolls X} {R : YM.RG.Supply.Protection D} {E : YM.RG.Supply.Delays R} {Z : YM.RG.Supply.Bar E}
  {u m : ℕ → ℕ} {c : (d : ℕ) → ι → YM.Next.Rank.Tapes.Panel d} {K : ℕ → Finset ℕ} (B : YM.Precision.MapPrices)
  (U : YM.RG.Supply.Wait Z) {z : ℕ → ℝ},
  YM.PhysicalNext.InteractingRank.Soft.AskSky X B u m c K →
    ∀ (O : YM.Next.Rank.HaarBudget G) (J : YM.Precision.ChartRatio G),
      YM.Precision.LocalRatio J →
        (∀ (i : ℕ), m i ≤ ↑(D.L i)) →
          (∀ (i : ℕ), 2 ≤ u i) →
            (∀ (i : ℕ), 0 ≤ z i) →
              G.Simple →
                ∃ W P,
                  U.minLength ≤ W.minLength ∧
                    U.readyHere ≤ W.readyHere ∧
                      U.window ≤ W.window ∧
                        (∀ (d : ℕ) (k : ι), (c d k).arc = (P d k).arc ∧ (c d k).θ = (P d k).θ) ∧
                          (∀ (d : ℕ) (i j : ι),
                              (P d i).θ = (P d j).θ ∧
                                ∀ (n : ℕ), ((P d i).bag n).era.coast.Q = ((P d j).bag n).era.coast.Q) ∧
                            ∀ (C : YM.Family G),
                              YM.RG.Supply.Paid W C.path.levels →
                                ∀ (B' : YM.PhysicalNext.RankCovariance.Binding C),
                                  B'.prices = B →
                                    ∀ (d : ℕ) (x : ι),
                                      ∀ᶠ (k : ℕ) in Filter.atTop,
                                        have a := (P d x).bag (C.path.levels.clock.J k);
                                        ∀ (y : ℝ),
                                          0 ≤ y →
                                            y ≤ a.band →
                                              YM.MergeProof.East.topL C.path.levels k ≤ C.path.levels.clock.monitor k ∧
                                                ∃ l r,
                                                  YM.PhysicalNext.InteractingRank.Soft.LegacyCostSky B' J (-3) (z d)
                                                    (YM.PhysicalNext.InteractingRank.Soft.vent a y) k (u d) d O l r
'YM.PhysicalNext.InteractingRank.Soft.forwardSky' depends on axioms: [propext, Classical.choice, Quot.sound]
def YM.PhysicalNext.InteractingRank.Soft.runTicket : {G : YM.Gauge} →
  {X : YM.RG.Supply.Sheet G} →
    {D : YM.RG.Supply.Rolls X} →
      {R : YM.RG.Supply.Protection D} → {E : YM.RG.Supply.Delays R} → YM.RG.Supply.Bar E → ℝ → ℕ → ℝ → Prop :=
fun {G} {X} {D} {R} {E} Z b j s =>
  have y := YM.Next.Rank.Ship.preHat Z s;
  have L := ↑(D.L j);
  have n := Real.log ↑L;
  have p := YM.Next.Rank.Ship.benchCost Z b (j - 1) s;
  Real.exp 1 ≤ y ∧ ↑p * n ≤ s / 2 ∧ ↑p * n * G.slopeConstant ≤ y / 4
def YM.PhysicalNext.InteractingRank.Soft.stretch : ℝ → ℝ → ℝ → ℕ :=
fun L b s => YM.Next.Rank.Station.bump L b s + YM.Next.Rank.Station.more L s
def YM.Next.Rank.Station.want : ℝ → ℝ → ℕ :=
fun u t => ⌈Real.log t / Real.log u⌉₊
def YM.Next.Rank.Station.bump : ℝ → ℝ → ℝ → ℕ :=
fun u b s => YM.Next.Rank.Station.want u (YM.Vac.Numbers.P s ^ b * YM.Vac.Numbers.P s ^ 2)
def YM.Next.Rank.Station.more : ℝ → ℝ → ℕ :=
fun u s => YM.Next.Rank.Station.want u (↑⌈Real.log s ^ 2⌉₊ ^ 10)
@YM.Next.Rank.Station.wanted : ∀ {u t : ℝ}, 1 < u → 0 < t → ∀ (i : ℕ), t ≤ u ^ i ↔ YM.Next.Rank.Station.want u t ≤ i
@YM.PhysicalNext.InteractingRank.Soft.office : ∀ {G : YM.Gauge} {X : YM.RG.Supply.Sheet G} (B : YM.Precision.MapPrices)
  {D : YM.RG.Supply.Rolls X} {b : YM.Next.Rank.Tapes.Purse} {j u : ℕ},
  (∀ i ∈ YM.PhysicalNext.InteractingRank.Soft.farSky j, YM.PhysicalNext.InteractingRank.Roh X B j b u (D.L i)) →
    YM.Next.Rank.Tapes.West.Coul b u →
      2 ≤ u →
        ∀ (J : YM.Precision.ChartRatio G),
          YM.Precision.LocalRatio J →
            0 ≤ b.band →
              ∀ (O : YM.Next.Rank.HaarBudget G) (z : ℝ) (n : ℕ),
                0 ≤ z →
                  ∃ W d δ,
                    ∃ (he : 0 < δ),
                      δ ≤ b.era.coast.a ∧
                        ∀ᶠ (s : ℝ) in Filter.atTop,
                          YM.PhysicalNext.InteractingRank.Soft.CapacitySky B D
                            (YM.PhysicalNext.InteractingRank.trim b δ he) W d s O z J u j n
