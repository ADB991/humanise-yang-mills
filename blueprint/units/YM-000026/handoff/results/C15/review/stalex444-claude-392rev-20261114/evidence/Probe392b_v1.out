def YM.RG.Calendar.hatBeta : {G : YM.Gauge} → YM.RG.Calendar G → ℕ → ℝ :=
fun {G} S m => S.bar + G.slopeConstant * S.schedule.scale m
def YM.RG.Calendar.monitor : {G : YM.Gauge} → YM.RG.Calendar G → ℕ → ℝ :=
fun {G} S m => Real.exp (Real.log (Real.log (S.hatBeta m)) ^ 2)
def YM.RG.Calendar.coverSize : {G : YM.Gauge} → YM.RG.Calendar G → ℕ → ℕ :=
fun {G} S m => ⌈Real.log (S.hatBeta m) ^ 2⌉₊
def YM.Schedule.a : YM.Schedule → ℕ → ℝ :=
fun S m => (↑↑(S.denominator m))⁻¹
def YM.Schedule.scale : YM.Schedule → ℕ → ℝ :=
fun S m => Real.log (S.a m)⁻¹
YM.Schedule.scale_succ : ∀ (S : YM.Schedule) (m : ℕ), S.scale (m + 1) = S.scale m + Real.log ↑↑(S.block m)
YM.Schedule.a_step : ∀ (S : YM.Schedule) (m : ℕ), S.a (m + 1) = S.a m / ↑↑(S.block m)
YM.Schedule.block_large : ∀ (self : YM.Schedule) (m : ℕ), 3 ≤ ↑(self.block m)
@YM.RG.Calendar.Fits.sameFactor : ∀ {G : YM.Gauge} {S : YM.RG.Calendar G},
  S.Fits → ∀ (m : ℕ), S.factor (S.J (m + 1)) = S.schedule.block m
@YM.RG.Calendar.Fits.delayed : ∀ {G : YM.Gauge} {S : YM.RG.Calendar G}, S.Fits → ∀ (m : ℕ), 1 < S.hatBeta m
@YM.RG.Calendar.Fits.mono : ∀ {G : YM.Gauge} {S : YM.RG.Calendar G}, S.Fits → Monotone S.J
@YM.RG.Calendar.Fits.stepSlow : ∀ {G : YM.Gauge} {S : YM.RG.Calendar G}, S.Fits → ∀ (m : ℕ), S.J (m + 1) ≤ S.J m + 1
structure YM.RG.Supply.Large {G : YM.Gauge} (p : YM.RG.Supply.Sheet G) (j : ℕ) (L : YM.Lattice.Side) : Prop
number of parameters: 4
fields:
  YM.RG.Supply.Large.odd : Odd ↑L
  YM.RG.Supply.Large.size : 3 ≤ ↑L
  YM.RG.Supply.Large.need : p.floorL j ≤ ↑L
  YM.RG.Supply.Large.kick : p.first ≤ j → (p.profile j).drift / Real.log ↑↑L ≤ G.slopeConstant / 4
  YM.RG.Supply.Large.slow : p.first ≤ j → (p.profile j).drift / Real.log ↑↑L ≤ (↑j ^ 2)⁻¹
  YM.RG.Supply.Large.fits : p.first ≤ j →
      let X := p.profile j;
      Real.log (1 + X.paths + X.width⁻¹ + X.columns + X.clip.relaxation + X.supportExponent) / Real.log ↑↑L ≤ (↑j ^ 2)⁻¹
constructor:
  YM.RG.Supply.Large.mk {G : YM.Gauge} {p : YM.RG.Supply.Sheet G} {j : ℕ} {L : YM.Lattice.Side} (odd : Odd ↑L)
    (size : 3 ≤ ↑L) (need : p.floorL j ≤ ↑L)
    (kick : p.first ≤ j → (p.profile j).drift / Real.log ↑↑L ≤ G.slopeConstant / 4)
    (slow : p.first ≤ j → (p.profile j).drift / Real.log ↑↑L ≤ (↑j ^ 2)⁻¹)
    (fits :
      p.first ≤ j →
        let X := p.profile j;
        Real.log (1 + X.paths + X.width⁻¹ + X.columns + X.clip.relaxation + X.supportExponent) / Real.log ↑↑L ≤
          (↑j ^ 2)⁻¹) :
    YM.RG.Supply.Large p j L
structure YM.RG.Supply.Rolls {G : YM.Gauge} (p : YM.RG.Supply.Sheet G) : Type
number of parameters: 2
fields:
  YM.RG.Supply.Rolls.L : ℕ → YM.Lattice.Side
  YM.RG.Supply.Rolls.large : ∀ (j : ℕ), YM.RG.Supply.Large p j (self.L j)
  YM.RG.Supply.Rolls.grow : Monotone fun j => ↑(self.L j)
constructor:
  YM.RG.Supply.Rolls.mk {G : YM.Gauge} {p : YM.RG.Supply.Sheet G} (L : ℕ → YM.Lattice.Side)
    (large : ∀ (j : ℕ), YM.RG.Supply.Large p j (L j)) (grow : Monotone fun j => ↑(L j)) : YM.RG.Supply.Rolls p
structure YM.RG.Supply.Wait {G : YM.Gauge} {p : YM.RG.Supply.Sheet G} {w : YM.RG.Supply.Rolls p}
  {T : YM.RG.Supply.Protection w} {W : YM.RG.Supply.Delays T} (Y : YM.RG.Supply.Bar W) : Type
number of parameters: 6
fields:
  YM.RG.Supply.Wait.readyHere : ℕ → ℝ
  YM.RG.Supply.Wait.window : ℕ → ℝ → ℕ
  YM.RG.Supply.Wait.sublin : ∀ (j : ℕ), Filter.Tendsto (fun s => ↑(self.window j s) / s) Filter.atTop (nhds 0)
  YM.RG.Supply.Wait.minLength : ℕ
constructor:
  YM.RG.Supply.Wait.mk {G : YM.Gauge} {p : YM.RG.Supply.Sheet G} {w : YM.RG.Supply.Rolls p}
    {T : YM.RG.Supply.Protection w} {W : YM.RG.Supply.Delays T} {Y : YM.RG.Supply.Bar W} (readyHere : ℕ → ℝ)
    (window : ℕ → ℝ → ℕ) (sublin : ∀ (j : ℕ), Filter.Tendsto (fun s => ↑(window j s) / s) Filter.atTop (nhds 0))
    (minLength : ℕ) : YM.RG.Supply.Wait Y
structure YM.RG.Supply.Paid {G : YM.Gauge} {p : YM.RG.Supply.Sheet G} {w : YM.RG.Supply.Rolls p}
  {T : YM.RG.Supply.Protection w} {W : YM.RG.Supply.Delays T} {Y : YM.RG.Supply.Bar W} (B : YM.RG.Supply.Wait Y)
  (a : YM.RG.Levels G) : Prop
number of parameters: 8
fields:
  YM.RG.Supply.Paid.kernel : a.clock.kernel = p.kernel
  YM.RG.Supply.Paid.bar : a.clock.bar = Y.value
  YM.RG.Supply.Paid.stage : a.clock.stage = p.profile
  YM.RG.Supply.Paid.firstZero : a.clock.J 0 = p.first
  YM.RG.Supply.Paid.firstOne : a.clock.J 1 = p.first
  YM.RG.Supply.Paid.lengths : a.clock.factor = w.L
  YM.RG.Supply.Paid.theta : a.clock.theta = T.theta
  YM.RG.Supply.Paid.pays : ∀ (m : ℕ), W.betaEntry (a.clock.J (m + 1)) ≤ a.clock.hatBeta m
  YM.RG.Supply.Paid.paysHigher : ∀ (m : ℕ),
      p.first < a.clock.J (m + 1) → W.scaleEntry (a.clock.J (m + 1)) Y.value ≤ a.S.scale m
  YM.RG.Supply.Paid.periods : ∀ (i : ℕ), B.minLength ≤ ↑(a.S.period i)
  YM.RG.Supply.Paid.volume : ∀ (m i : ℕ),
      let j := a.clock.J (m + 1);
      W.shells j * (1 + a.clock.coverSize m + a.clock.coverSize (m + 1)) ^ W.growth j ≤ ↑(a.S.side m i)
  YM.RG.Supply.Paid.run : ∀ (j : ℕ),
      p.first ≤ j →
        ∃ k,
          B.readyHere j ≤ a.S.scale k ∧
            B.window j (a.S.scale k) ≤ k ∧
              ∀ (i : ℕ), k - B.window j (a.S.scale k) ≤ i → i ≤ k + B.window j (a.S.scale k) → a.clock.J i = j
constructor:
  YM.RG.Supply.Paid.mk {G : YM.Gauge} {p : YM.RG.Supply.Sheet G} {w : YM.RG.Supply.Rolls p}
    {T : YM.RG.Supply.Protection w} {W : YM.RG.Supply.Delays T} {Y : YM.RG.Supply.Bar W} {B : YM.RG.Supply.Wait Y}
    {a : YM.RG.Levels G} (kernel : a.clock.kernel = p.kernel) (bar : a.clock.bar = Y.value)
    (stage : a.clock.stage = p.profile) (firstZero : a.clock.J 0 = p.first) (firstOne : a.clock.J 1 = p.first)
    (lengths : a.clock.factor = w.L) (theta : a.clock.theta = T.theta)
    (pays : ∀ (m : ℕ), W.betaEntry (a.clock.J (m + 1)) ≤ a.clock.hatBeta m)
    (paysHigher : ∀ (m : ℕ), p.first < a.clock.J (m + 1) → W.scaleEntry (a.clock.J (m + 1)) Y.value ≤ a.S.scale m)
    (periods : ∀ (i : ℕ), B.minLength ≤ ↑(a.S.period i))
    (volume :
      ∀ (m i : ℕ),
        let j := a.clock.J (m + 1);
        W.shells j * (1 + a.clock.coverSize m + a.clock.coverSize (m + 1)) ^ W.growth j ≤ ↑(a.S.side m i))
    (run :
      ∀ (j : ℕ),
        p.first ≤ j →
          ∃ k,
            B.readyHere j ≤ a.S.scale k ∧
              B.window j (a.S.scale k) ≤ k ∧
                ∀ (i : ℕ), k - B.window j (a.S.scale k) ≤ i → i ≤ k + B.window j (a.S.scale k) → a.clock.J i = j) :
    YM.RG.Supply.Paid B a
structure YM.Next.Rank.Station.AllowedSky {G : YM.Gauge} (A : YM.RG.Levels G) (b : ℝ) (k : ℕ) : Prop
number of parameters: 4
fields:
  YM.Next.Rank.Station.AllowedSky.dilation : YM.Next.Rank.Station.mag A b k * A.clock.monitor k ^ 2 ≤
      A.S.a (YM.Next.Rank.Station.middleSky A b k) / A.S.a k
  YM.Next.Rank.Station.AllowedSky.depth : ↑(A.clock.coverSize k) ^ 10 ≤
      A.S.a (YM.Next.Rank.Station.widthSky A b k) / A.S.a (YM.Next.Rank.Station.middleSky A b k)
  YM.Next.Rank.Station.AllowedSky.large : 2 ≤ YM.Next.Rank.Station.wheelSky A k
  YM.Next.Rank.Station.AllowedSky.bracket : ∀ (m : ℕ),
      YM.Next.Rank.Station.widthSky A b k ≤ m → m ≤ k → A.clock.J k - 1 ≤ A.clock.J m
constructor:
  YM.Next.Rank.Station.AllowedSky.mk {G : YM.Gauge} {A : YM.RG.Levels G} {b : ℝ} {k : ℕ}
    (dilation :
      YM.Next.Rank.Station.mag A b k * A.clock.monitor k ^ 2 ≤ A.S.a (YM.Next.Rank.Station.middleSky A b k) / A.S.a k)
    (depth :
      ↑(A.clock.coverSize k) ^ 10 ≤
        A.S.a (YM.Next.Rank.Station.widthSky A b k) / A.S.a (YM.Next.Rank.Station.middleSky A b k))
    (large : 2 ≤ YM.Next.Rank.Station.wheelSky A k)
    (bracket : ∀ (m : ℕ), YM.Next.Rank.Station.widthSky A b k ≤ m → m ≤ k → A.clock.J k - 1 ≤ A.clock.J m) :
    YM.Next.Rank.Station.AllowedSky A b k
def YM.Next.Rank.Station.leastL : {G : YM.Gauge} → YM.RG.Levels G → ℕ → YM.Lattice.Side :=
fun {G} A k => min (A.clock.factor (A.clock.J k)) (A.clock.factor (A.clock.J k - 1))
def YM.Next.Rank.Station.wheelSky : {G : YM.Gauge} → YM.RG.Levels G → ℕ → ℝ :=
fun {G} A k => ↑↑(YM.Next.Rank.Station.leastL A k)
def YM.Next.Rank.Station.gainSky : YM.Schedule → ℕ → ℝ → ℕ :=
fun T i r => {j ∈ Finset.range (i + 1) | r ≤ T.a j / T.a i}.sup id
def YM.Next.Rank.Station.middleSky : {G : YM.Gauge} → YM.RG.Levels G → ℝ → ℕ → ℕ :=
fun {G} A b k => YM.Next.Rank.Station.gainSky A.S k (YM.Next.Rank.Station.mag A b k * A.clock.monitor k ^ 2)
def YM.Next.Rank.Station.widthSky : {G : YM.Gauge} → YM.RG.Levels G → ℝ → ℕ → ℕ :=
fun {G} A b k => YM.Next.Rank.Station.gainSky A.S (YM.Next.Rank.Station.middleSky A b k) (↑(A.clock.coverSize k) ^ 10)
def YM.Next.Rank.Station.mag : {G : YM.Gauge} → YM.RG.Levels G → ℝ → ℕ → ℝ :=
fun {G} A b k => A.clock.monitor k ^ b
@[reducible] def YM.Next.Rank.Atlas.clim : {G : YM.Gauge} → YM.RG.Levels G → ℕ → ℝ :=
fun {G} A k => A.clock.hatBeta k
@YM.Next.Rank.Station.gain_high : ∀ {T : YM.Schedule} {i j : ℕ} {r : ℝ},
  j ≤ i → r ≤ T.a j / T.a i → r ≤ T.a (YM.Next.Rank.Station.gainSky T i r) / T.a i
@YM.Next.Rank.Station.gain_fee : ∀ {T : YM.Schedule} {i j : ℕ} {r : ℝ},
  j ≤ i → r ≤ T.a j / T.a i → j ≤ YM.Next.Rank.Station.gainSky T i r
structure YM.Next.Rank.Tapes.CorridorSky {G : YM.Gauge} (A : YM.RG.Levels G) (s : ℝ) (p : YM.Next.Rank.Tapes.Purse)
  (k : ℕ) : Prop
number of parameters: 5
