      ∀ (s : YM.Signed) (x : (C.labels.level ↑d).Coeff),
        (p d) ((YM.Next.Rank.East.mir (C.labels.level ↑d) s) x) =
          (YM.Next.Rank.East.mir (C.labels.level ↑d) s) ((p d) x)
