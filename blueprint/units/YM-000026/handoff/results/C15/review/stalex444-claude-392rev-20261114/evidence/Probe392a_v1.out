def YM.Next.Rank.Perch.y : ℝ → ℝ :=
fun s => Real.log (Real.log s)
def YM.Next.Rank.Perch.M : ℝ → ℕ :=
fun s => ⌈Real.log s ^ 2⌉₊
def YM.Next.Rank.Perch.walls : ℝ → ℕ :=
fun s => YM.Next.Rank.Perch.M s ^ 2
def YM.Next.Rank.Perch.hot : ℝ → ℝ :=
fun s => Real.exp (YM.Next.Rank.Perch.y s ^ (3 / 2))
